{
  "name": "fishnet",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @fishnet/extension dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @fishnet/extension e2e",
    "typecheck": "pnpm -r typecheck && tsc -p bench",
    "bench": "tsx bench/run.ts",
    "bench:gen": "tsx bench/generate.ts",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
